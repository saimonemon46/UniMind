# UniMind Environment Configuration Example
# Copy this file to .env and fill in your free tier API keys and local settings.

# ------------------------------------------------------------------------------
# 1. AI Service Configuration (Free Tier AI Provider: Groq or Gemini)
# ------------------------------------------------------------------------------
# Get your free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_free_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Alternative Free Tier LLM Option (Google Gemini):
# GEMINI_API_KEY=your_free_gemini_api_key_here

AI_SERVICE_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# 2. Django Backend Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True

# Database: Leave empty for SQLite dev database (db.sqlite3) or configure PostgreSQL
# DATABASE_URL=postgresql://postgres:alma_secret@localhost:5432/unimind

# ------------------------------------------------------------------------------
# 3. Redis & Celery (Optional for background tasks)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. Storage & Storage (MinIO / S3 - Optional for dev)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=alma_minio
MINIO_SECRET_KEY=alma_minio_secret
